generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  admin
  kasir
  member

  @@map("user_role")
}

enum OrderStatus {
  waiting
  confirmed
  cancelled

  @@map("order_status")
}

enum PaymentMethod {
  qris
  transfer_bank
  cash

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  paid
  failed

  @@map("payment_status")
}

// ============================================
// MODELS
// ============================================

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  name        String
  role        UserRole @default(member)
  phone       String?
  points      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  ordersAsMember    Order[]         @relation("MemberOrders")
  ordersConfirmed   Order[]         @relation("ConfirmedOrders")
  inventoryLogs     InventoryLog[]

  @@map("profiles")
}

model Table {
  id          String   @id @default(uuid()) @db.Uuid
  tableNumber Int      @unique @map("table_number")
  qrToken     String   @unique @default(uuid()) @map("qr_token")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  orders Order[]

  @@map("tables")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  categoryId  String?  @map("category_id") @db.Uuid
  imageUrl    String?  @map("image_url")
  stock       Int      @default(0)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  discountEventItems DiscountEventItem[]
  inventoryLogs      InventoryLog[]

  @@index([categoryId], map: "idx_menu_items_category")
  @@map("menu_items")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tableId       String      @map("table_id") @db.Uuid
  memberId      String?     @map("member_id") @db.Uuid
  status        OrderStatus @default(waiting)
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(10, 2)
  grandTotal    Decimal     @default(0) @map("grand_total") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  confirmedAt   DateTime?   @map("confirmed_at") @db.Timestamptz()
  confirmedBy   String?     @map("confirmed_by") @db.Uuid

  // Relations
  table      Table      @relation(fields: [tableId], references: [id])
  member     Profile?   @relation("MemberOrders", fields: [memberId], references: [id], onDelete: SetNull)
  confirmer  Profile?   @relation("ConfirmedOrders", fields: [confirmedBy], references: [id])
  orderItems OrderItem[]
  payments   Payment[]

  @@index([status], map: "idx_orders_status")
  @@index([tableId], map: "idx_orders_table_id")
  @@index([createdAt(sort: Desc)], map: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  qty            Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId], map: "idx_order_items_order_id")
  @@map("order_items")
}

model DiscountEvent {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  type        String
  value       Decimal  @db.Decimal(10, 2)
  startAt     DateTime @map("start_at") @db.Timestamptz()
  endAt       DateTime @map("end_at") @db.Timestamptz()
  isActive    Boolean  @default(true) @map("is_active")
  appliesToAll Boolean @default(false) @map("applies_to_all")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  items DiscountEventItem[]

  @@map("discount_events")
}

model DiscountEventItem {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid

  // Relations
  event    DiscountEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([eventId, menuItemId])
  @@map("discount_event_items")
}

model InventoryLog {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  changeQty  Int      @map("change_qty")
  reason     String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  creator  Profile? @relation(fields: [createdBy], references: [id])

  @@index([menuItemId], map: "idx_inventory_logs_menu_item")
  @@map("inventory_logs")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(pending)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_payments_order_id")
  @@map("payments")
}
